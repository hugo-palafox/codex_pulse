<Window x:Class="CodexPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Pulse"
        Width="300"
        Height="180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True">
  <Window.Resources>
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="20" ShadowDepth="5" Direction="270" Color="#99000000" Opacity="0.35" />
  </Window.Resources>

  <Border Margin="10"
          Padding="20"
          CornerRadius="20"
          Background="Transparent"
          BorderBrush="#66FFFFFF"
          BorderThickness="1"
          ClipToBounds="True"
          Effect="{StaticResource GlassShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CODEX" Foreground="{StaticResource GlassAccent}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="Limits" Foreground="{StaticResource GlassText}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource GlassIconButton}" ToolTip="Drag window" PreviewMouseLeftButtonDown="DragHandleMouseDown">
            <TextBlock Text="⠿" FontSize="15" />
          </Button>
          <Button Style="{StaticResource GlassIconButton}" ToolTip="Toggle always on top" Click="ToggleTopmostClick">
            <Path x:Name="TopmostIcon"
                  Width="15"
                  Height="15"
                  Stretch="Uniform"
                  Data="M 3,2 L 13,2 L 11,6 L 14,10 L 2,10 L 5,6 Z M 8,10 L 8,15"
                  Stroke="{StaticResource GlassText}"
                  StrokeThickness="1.4"
                  StrokeLineJoin="Round" />
          </Button>
          <Button Style="{StaticResource GlassIconButton}" ToolTip="Close to tray" Click="HideClick">
            <TextBlock Text="×" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,17,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <TextBlock Text="5 hrs limits" Foreground="{StaticResource GlassMutedText}" FontSize="13" />
          <TextBlock Grid.Column="1" Text="{Binding FiveHourRemainingText}" HorizontalAlignment="Right" Foreground="{StaticResource GlassText}" FontSize="13" FontWeight="SemiBold" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <TextBlock Text="Week usage" Foreground="{StaticResource GlassMutedText}" FontSize="13" />
          <TextBlock Grid.Column="1" Text="{Binding WeekRemainingText}" HorizontalAlignment="Right" Foreground="{StaticResource GlassText}" FontSize="13" FontWeight="SemiBold" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
