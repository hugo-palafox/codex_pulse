<Window x:Class="CodexPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Pulse"
        Width="260"
        Height="125"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True">
  <Window.Resources>
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Color="#99000000" Opacity="0.35" />
  </Window.Resources>

  <Border Margin="5"
          Padding="10"
          CornerRadius="14"
          Background="Transparent"
          BorderBrush="#66FFFFFF"
          BorderThickness="1"
          ClipToBounds="True"
          Effect="{StaticResource GlassShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Limits" Foreground="{StaticResource GlassText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource GlassIconButton}" Padding="4,1" ToolTip="Drag window" PreviewMouseLeftButtonDown="DragHandleMouseDown">
            <TextBlock Text="⠿" FontSize="12" />
          </Button>
          <Button Style="{StaticResource GlassIconButton}" Padding="4,1" ToolTip="Toggle always on top" Click="ToggleTopmostClick">
            <Path x:Name="TopmostIcon"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  Data="M 3,2 L 13,2 L 11,6 L 14,10 L 2,10 L 5,6 Z M 8,10 L 8,15"
                  Stroke="{StaticResource GlassText}"
                  StrokeThickness="1.4"
                  StrokeLineJoin="Round" />
          </Button>
          <Button Style="{StaticResource GlassIconButton}" Padding="4,1" ToolTip="Close to tray" Click="HideClick">
            <TextBlock Text="×" FontSize="13" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,5,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="5 hrs limits" Foreground="{StaticResource GlassMutedText}" FontSize="12" />
          <TextBlock Grid.Column="2" Text="{Binding FiveHourRemainingText}" HorizontalAlignment="Right" Foreground="{StaticResource GlassText}" FontSize="12" FontWeight="SemiBold" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding FiveHourResetText}" Margin="0,1,0,0" HorizontalAlignment="Right" Foreground="{StaticResource GlassMutedText}" FontSize="9" />
        <Grid Grid.Row="2" Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Week usage" Foreground="{StaticResource GlassMutedText}" FontSize="12" />
          <TextBlock Grid.Column="1" Text="{Binding WeekRemainingText}" HorizontalAlignment="Right" Foreground="{StaticResource GlassText}" FontSize="12" FontWeight="SemiBold" />
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding WeekResetText}" Margin="0,1,0,0" HorizontalAlignment="Right" Foreground="{StaticResource GlassMutedText}" FontSize="9" />
      </Grid>
    </Grid>
  </Border>
</Window>
